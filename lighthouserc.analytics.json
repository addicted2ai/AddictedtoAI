{
  "ci": {
    "collect": {
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8, "aggregationMethod": "median" }],
        "categories:accessibility": ["warn", { "minScore": 0.85, "aggregationMethod": "median" }],
        "categories:seo": ["warn", { "minScore": 0.85, "aggregationMethod": "median" }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
