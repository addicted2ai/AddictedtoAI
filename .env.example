# Copy to .env.local for local dev, and set the real values as
# environment variables in the Vercel project settings.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Optional:
# leave it blank and the site emits no analytics script at all.
# NEXT_PUBLIC_* values are inlined at build time, so setting this
# requires a redeploy to take effect.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public URL of this repository:
# https://github.com/addicted2ai/AddictedtoAI. Optional. When set, /log
# turns every round's number into a link to the change itself -- a pull
# request for rounds built here, a commit for rounds carried over from
# the private predecessor repository, whose pull requests could not be
# migrated. See app/lib/pr-archive.js and archive/README.md.
NEXT_PUBLIC_REPO_URL=https://github.com/addicted2ai/AddictedtoAI
