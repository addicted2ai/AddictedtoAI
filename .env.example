# Copy to .env.local for local dev, and set the real values as
# environment variables in the Vercel project settings.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Optional:
# leave it blank and the site emits no analytics script at all.
# NEXT_PUBLIC_* values are inlined at build time, so setting this
# requires a redeploy to take effect.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public URL of this repository, e.g.
# https://github.com/addicted2ai/AddictedtoAIdotnet. Optional. When set,
# /log turns every round's PR number into a link to the real pull
# request. Leave it blank while the repo is private -- those URLs 404
# for anyone not signed in, and the link check will (correctly) fail.
NEXT_PUBLIC_REPO_URL=
