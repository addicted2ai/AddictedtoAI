# Dependencies
node_modules/
.pnp
.pnp.js

# Build output — anchored to the repository root on purpose. The entire
# data/ tree is committed (design D1, task 1.3); nothing under data/ may
# ever be ignored, and an unanchored pattern here could do that by accident.
/.next/
/out/
/build/
/dist/

# Environment — never commit these
.env
.env.local
.env.*.local

# Vercel
.vercel

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# TypeScript (generated by next build)
/next-env.d.ts
*.tsbuildinfo

# Editor
.idea/
*.swp

# Claude Code local settings
.claude/settings.local.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
